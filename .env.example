# XProtect (server-side worker only)
XPROTECT_BASE_URL=http://localhost
XPROTECT_USERNAME=
XPROTECT_PASSWORD=
# Optional override for the installed Milestone MIP SDK assembly directory.
# XPROTECT_MIPSDK_DIR=C:\Program Files\Milestone\XProtect Mobile Server

# Hafnia Gateway (server-side worker only)
HAFNIA_BASE_URL=https://localhost:15443
HAFNIA_USERNAME=administrator
HAFNIA_GW_PASSWORD=
HAFNIA_TLS_VERIFY=true
# HAFNIA_CA_BUNDLE=C:\path\to\gateway-ca.pem
HAFNIA_MODEL=traffic-general
# DUMPING_PROMPT_PATH=C:\path\to\dumping_v1.txt

# Supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy only these public values to webapp/.env.local when browser access is needed.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Video analytics runtime
HTTP_TIMEOUT_SECONDS=60
HAFNIA_POLL_INTERVAL_SECONDS=3
HAFNIA_POLL_TIMEOUT_SECONDS=600
TRACEDUMP_RUNS_DIR=./runs/hafnia
TRACEDUMP_EXPORTS_DIR=./runs/xprotect
