# XProtect (server-side worker only)
XPROTECT_BASE_URL=https://xprotect.example.invalid
XPROTECT_USERNAME=
XPROTECT_PASSWORD=
XPROTECT_CAMERA_IDS=

# Hafnia Gateway (server-side worker only)
HAFNIA_GATEWAY_URL=https://hafnia.example.invalid
HAFNIA_API_KEY=

# Supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy only these public values to webapp/.env.local when browser access is needed.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Video analytics runtime
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_CONCURRENCY=2
WORKER_ARTIFACT_DIR=./runs
LOG_LEVEL=INFO
