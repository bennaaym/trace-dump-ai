# Configuration contract for TraceDump AI. Copy only what each runtime needs:
#   webapp/.env.local          -> the "Webapp" section
#   video-analytics/.env       -> the "Video analytics worker" section
# Never commit real values. Server-side secrets must never use a NEXT_PUBLIC_ prefix.

# --- Webapp (browser-safe values only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Video analytics worker (server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

XPROTECT_BASE_URL=http://localhost
XPROTECT_USERNAME=
XPROTECT_PASSWORD=
XPROTECT_MIPSDK_DIR=

HAFNIA_BASE_URL=https://localhost:15443
HAFNIA_USERNAME=administrator
HAFNIA_GW_PASSWORD=
HAFNIA_MODEL=traffic-general
HAFNIA_TLS_VERIFY=true
HAFNIA_CA_BUNDLE=
HAFNIA_POLL_INTERVAL_SECONDS=3
HAFNIA_POLL_TIMEOUT_SECONDS=600
HTTP_TIMEOUT_SECONDS=60

DUMPING_PROMPT_PATH=
TRACEDUMP_RUNS_DIR=
TRACEDUMP_EXPORTS_DIR=

# On-demand incident playback
TRACEDUMP_PLAYBACK_CACHE_DIR=
TRACEDUMP_PLAYBACK_RETENTION_HOURS=24
TRACEDUMP_PLAYBACK_TRANSCODE_THREADS=1

# AI site checks for overdue cases (video-analytics site-check-worker)
SITE_CHECK_PROMPT_PATH=
# Minimum hours between checks of the same case.
TRACEDUMP_SITE_CHECK_MIN_INTERVAL_HOURS=12
# Maximum checks started per rolling 24 hours across all cases (protects the Hafnia allowance).
TRACEDUMP_SITE_CHECK_DAILY_LIMIT=20
# Length in seconds of the recent footage sent to Hafnia for each check.
TRACEDUMP_SITE_CHECK_WINDOW_SECONDS=60
