# Next.js / Supabase (copy these values to webapp/.env)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only XProtect WebRTC signaling (also copy to webapp/.env)
XPROTECT_BASE_URL=http://localhost
XPROTECT_USERNAME=
XPROTECT_PASSWORD=

# Windows scene-check worker only (also copy to video-analytics/.env)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HAFNIA_BASE_URL=https://localhost:15443
HAFNIA_USERNAME=administrator
HAFNIA_GW_PASSWORD=
HAFNIA_MODEL=traffic-general
# The hackathon gateway uses a self-signed certificate. Restrict this setting
# to its dedicated local client; prefer HAFNIA_CA_BUNDLE outside the kit.
HAFNIA_TLS_VERIFY=false
