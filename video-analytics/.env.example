# XProtect
XPROTECT_BASE_URL=https://your-xprotect-server
XPROTECT_USERNAME=your-username
XPROTECT_PASSWORD=your-password
XPROTECT_MIPSDK_DIR=C:\Program Files\Milestone\XProtect Mobile Server

# Supabase (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hafnia Gateway
HAFNIA_BASE_URL=https://localhost:15443
HAFNIA_USERNAME=administrator
HAFNIA_GW_PASSWORD=your-password
HAFNIA_TLS_VERIFY=true
HAFNIA_MODEL=traffic-general

# Workers
SIMULATION_YOLO_MODEL=C:\path\to\yolo11n.pt
SCENE_SOURCE_ADAPTER=xprotect_camera
