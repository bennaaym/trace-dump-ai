# Supabase browser credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only XProtect credentials (never prefix these with NEXT_PUBLIC_)
XPROTECT_BASE_URL=https://your-xprotect-server
XPROTECT_USERNAME=your-username
XPROTECT_PASSWORD=your-password
